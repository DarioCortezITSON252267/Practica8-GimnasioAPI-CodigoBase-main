

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Clase {
  id     Int    @id @default(autoincrement())
  nombre String @db.VarChar(80)

  // Prisma nombra la tabla como el modelo: "Clase". @@map la renombra
  // a minusculas y en plural, que es la convencion en MySQL.
  @@map("clases")
}
